<?xml version="1.0" ?>
<scenario>
	<looks>
		<look
            name="br2"
            gray="1.0"
            roughness="0.4"
            metalness="0.5"
            texture="texture/br2.png"
        />
		<look name="blue" rgb="0.0 0.5 1.0" roughness="0.3" />
	</looks>

	<robot name="bluerov2" fixed="false" self_collisions="false">
		<base_link name="base_link" type="compound" physics="submerged">
			<external_part
                name="HullBottom"
                type="model"
                physics="submerged"
                buoyant="false"
            >
				<physical>
					<mesh filename="obj/bluerov2_phy.obj" scale="1" />
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
					<thickness value="0.005" />
				</physical>
				<visual>
					<mesh filename="obj/bluerov2.obj" scale="1" />
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
				</visual>
				<material name="Fiberglass" />
				<look name="br2" />
				<compound_transform rpy="0 0.0 0.0" xyz="-0.0 0.0 0.0" />
				<mass value="5.9" />
			</external_part>

			<external_part name="HeavyFit" type="model" physics="submerged" buoyant="true">
				<physical>
					<mesh filename="obj/bluerov2_ring.obj" scale="1" />
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.03" />
					<thickness value="0.005" />
				</physical>
				<visual>
					<mesh filename="obj/bluerov2_wings.obj" scale="1" />
					<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
				</visual>
				<material name="Fiberglass" />
				<look name="black" />
				<compound_transform rpy="0 0.0 0.0" xyz="-0.0 0.0 0.0" />
			</external_part>

			<internal_part name="BackLeft" type="box" physics="submerged" buoyant="true">
				<dimensions xyz="0.2 0.15 0.091" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Neutral" />
				<look name="None" />
				<mass value="0.22" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="-0.1 -0.1 0.0" />
			</internal_part>

			<internal_part name="BackRight" type="box" physics="submerged" buoyant="true">
				<dimensions xyz="0.2 0.15 0.091" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Neutral" />
				<look name="None" />
				<mass value="0.22" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="-0.1 0.1 0.0" />
			</internal_part>

			<internal_part name="FrontLeft" type="box" physics="submerged" buoyant="true">
				<dimensions xyz="0.2 0.15 0.091" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Neutral" />
				<look name="None" />
				<mass value="0.22" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.09 -0.1 0.0" />
			</internal_part>

			<internal_part name="FrontRight" type="box" physics="submerged" buoyant="true">
				<dimensions xyz="0.2 0.15 0.091" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Neutral" />
				<look name="None" />
				<mass value="0.22" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.09 0.1 0.0" />
			</internal_part>

			<!-- <internal_part name="TopLeft" type="cylinder" physics="submerged" buoyant="true">
				<dimensions radius="0.04" height="0.32"/>
				<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<mass value="0.1"/>
				<look name="manipulator"/>
				<compound_transform rpy="0.0 1.571 0.0" xyz="-0.005 -0.1 0.0"/>
			</internal_part>

			<internal_part name="TopRight" type="cylinder" physics="submerged" buoyant="true">
				<dimensions radius="0.04" height="0.32"/>
				<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<mass value="0.1"/>
				<look name="manipulator"/>
				<compound_transform rpy="0.0 1.571 0.0" xyz="-0.005 0.1 0.0"/>
			</internal_part>  -->

			<!-- <internal_part name="BuoyLeft" type="sphere" physics="submerged" buoyant="true">
				<dimensions radius="0.075"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="Blue"/>
				<mass value=".05"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="-0.005 -0.075 0.0"/>
			</internal_part>

			<internal_part name="BuoyRight" type="sphere" physics="submerged" buoyant="true">
				<dimensions radius="0.075"/>
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
				<material name="Neutral"/>
				<look name="Blue"/>
				<mass value=".05"/>
				<compound_transform rpy="0.0 0.0 0.0" xyz="-0.005 0.075 0.0"/>
			</internal_part> -->

			<internal_part
                name="WeightCenter"
                type="sphere"
                physics="submerged"
                buoyant="false"
            >
				<dimensions radius="0.01" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Steel" />
				<look name="black" />
				<mass value="1.75" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.1" />
			</internal_part>

			<internal_part
                name="WeightLeft"
                type="sphere"
                physics="submerged"
                buoyant="false"
            >
				<dimensions radius="0.01" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Steel" />
				<look name="black" />
				<mass value="1" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 -0.075 0.1" />
			</internal_part>

			<internal_part
                name="WeightRight"
                type="sphere"
                physics="submerged"
                buoyant="false"
            >
				<dimensions radius="0.01" />
				<origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
				<material name="Steel" />
				<look name="black" />
				<mass value="1" />
				<compound_transform rpy="0.0 0.0 0.0" xyz="0.0 0.075 0.1" />
			</internal_part>
		</base_link>

		<!-- Thruster 1 -->
		<actuator name="FrontRight" type="thruster">
			<link name="base_link" />
			<origin xyz="0.1355 0.1 0.0725" rpy="0 0 -0.7853981634" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/cw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>
			
			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 2 -->
		<actuator name="FrontLeft" type="thruster">
			<link name="base_link" />
			<origin xyz="0.1355 -0.1 0.0725" rpy="0 0 0.7853981634" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/ccw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 3 -->
		<actuator name="BackRight" type="thruster">
			<link name="base_link" />
			<origin xyz="-0.1475 0.1 0.0725" rpy="0 0 -2.3561944902" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/cw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 4 -->
		<actuator name="BackLeft" type="thruster">
			<link name="base_link" />
			<origin xyz="-0.1475 -0.1 0.0725" rpy="0 0 2.3561944902" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/ccw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 5 -->
		<actuator name="DiveFrontRight" type="thruster">
			<link name="base_link" />
			<origin xyz="0.12 0.218 0.0" rpy="0 -1.5707963268 0" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/cw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 6 -->
		<actuator name="DiveFrontLeft" type="thruster">
			<link name="base_link" />
			<origin xyz="0.12 -0.218 0.0" rpy="0 -1.5707963268 0" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/ccw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 7 -->
		<actuator name="DiveBackRight" type="thruster">
			<link name="base_link" />
			<origin xyz="-0.12 0.218 0.0" rpy="0 -1.5707963268 0" />
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/ccw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>
		</actuator>

		<!-- Thruster 8 -->
		<actuator name="DiveBackLeft" type="thruster">
			<specs max_setpoint="340.0" inverted_setpoint="false" normalized_setpoint="true"/>
			
			<propeller diameter="0.076" right="true">
				<mesh filename="obj/cw.obj" scale="1.0" />
				<material name="Neutral" />
				<look name="blue" />
			</propeller>

			<rotor_dynamics type="zero_order"/>

			<thrust_model type="fluid_dynamics">
				<thrust_coeff forward="0.167" reverse="0.12"/>
				<torque_coeff value="0.016"/>
			</thrust_model>

			<origin xyz="-0.12 -0.218 0.0" rpy="0 -1.5707963268 0" />
			<link name="base_link" />
		</actuator>

		<link name="sonar_link" type="box" physics="submerged">
			<dimensions xyz="0.02 0.02 0.02" />
			<origin xyz="0 0 0" rpy="0 0 0" />
			<material name="Neutral" />
			<look name="blue" />
		</link>

		<joint name="base_link_to_sonar" type="revolute">
			<parent name="base_link" />
			<child name="sonar_link" />
			<origin xyz="0.2 0.0 0.3" rpy="1.571 0.0 1.571" />
			<axis xyz="0.0 0.0 1.0" />
		</joint>

		<actuator name="Servo" type="servo">
		    <joint name="base_link_to_sonar" />
		    <controller
                position_gain="1.0"
                velocity_gain="1.0"
                max_torque="10.0"
                max_velocity="0.1"
            />
		</actuator>

		<sensor name="odometry" type="odometry" rate="100.0">
			<!-- <noise position="0.05" velocity="0.01" angle="0.1" angular_velocity="0.05"/> -->
			<link name="base_link" />
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
			<ros_publisher topic="/StoneFish/Odometry" />
		</sensor>

		<sensor name="odometry_noisy" type="odometry" rate="300.0">
			<noise velocity="0.01" angular_velocity="0.05" />
			<link name="base_link" />
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0" />
			<!--<ros_publisher topic="/StoneFish/Odometry_noisy" />-->
		</sensor>

		<sensor name="Gyrodqwdwqdwq" rate="10.0" type="gyro">
			<range angular_velocity="100.0 100.0 200.0" />
			<noise angular_velocity="100" bias="0.003" />
			<history samples="1" />
			<origin xyz="0.1 0.0 0.0" rpy="0.0 0.0 0.0" />
			<link name="base_link" />
		</sensor>

		<sensor name="Dcam" rate="10.0" type="depthcamera">
		    <specs
                resolution_x="256"
                resolution_y="64"
                horizontal_fov="90.0"
                depth_min="0.2"
                depth_max="15.0"
            />
			<origin rpy="1.571 0.0 1.571" xyz="0.2 0.0 0.3" />
		    <link name="base_link" />
		    <ros_publisher topic="/sensor_msgs"/>
		</sensor>

		<sensor name="SCam" rate="10.0" type="segmentation">
            <specs resolution_x="800" resolution_y="600" horizontal_fov="60.0"/>
            <origin rpy="1.571 0.0 1.571" xyz="0.2 0.0 0.3" />
            <link name="base_link"/>
            <ros_publisher topic="/StoneFish/Segmentation"/>
        </sensor> 


		<world_transform xyz="0 0 8" rpy="0 0 0" />

		<ros_subscriber
            thrusters="/bluerov2/controller/thruster_setpoints_sim"
            servos="/bluerov2/controller/sonar_servo_setpoints_sim"
        />
		<ros_publisher
            thrusters="/bluerov2/controller/thruster_state"
            servos="/bluerov2/controller/sonar_servo_state"
        />
	</robot>
</scenario>
