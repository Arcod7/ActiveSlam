From 4bf39929a101c710b4550d512c3c74cc3115bfdd Mon Sep 17 00:00:00 2001
From: ActiveSlam <noreply@activeslam.local>
Date: Tue, 22 Jul 2026 00:00:00 +0000
Subject: [PATCH] fix event timestamps with ROS 2 Humble

Humble does not provide an operator that adds rclcpp::Duration directly to a
builtin_interfaces::msg::Time. Convert the header timestamp to rclcpp::Time,
then convert the result back to its message representation.
---
 src/stonefish_ros2/ROS2Interface.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/stonefish_ros2/ROS2Interface.cpp b/src/stonefish_ros2/ROS2Interface.cpp
index 048a7d4..694c408 100644
--- a/src/stonefish_ros2/ROS2Interface.cpp
+++ b/src/stonefish_ros2/ROS2Interface.cpp
@@ -694,7 +694,9 @@ void ROS2Interface::PublishEventBasedCamera(rclcpp::PublisherBase::SharedPtr pu
         msg.events[i].x = (unsigned int)(data[i*2] >> 16);
         msg.events[i].y = (unsigned int)(data[i*2] & 0xFFFF); 
         //Next 4 bytes - polarity and time
-        msg.events[i].ts = msg.header.stamp + rclcpp::Duration(0, abs(data[i*2+1]));
+        msg.events[i].ts = rclcpp::Time(msg.header.stamp) + rclcpp::Duration(0, abs(data[i*2+1]));
         msg.events[i].polarity = data[i*2+1] > 0;
     }
     std::static_pointer_cast<rclcpp::Publisher<stonefish_ros2::msg::EventArray>>(pub)->publish(msg);
