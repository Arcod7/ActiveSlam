<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>basic_slam</name>
  <version>0.1.0</version>
  <description>Ground-truth SLAM pipeline: Stonefish → depth_image_proc → OctoMap</description>
  <maintainer email="ave4000@hw.ac.uk">arcod7</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Python nodes -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Nodes launched by this package -->
  <exec_depend>stonefish_ros2</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>octomap_server</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
