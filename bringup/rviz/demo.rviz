    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /Sonar PointCloud1/Topic1
        - /Octomap1/Topic1
        - /Octomap1/Namespaces1
        - /Frontiers1/Namespaces1
      Splitter Ratio: 0.5346534848213196
    Tree Height: 1496
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: eval_hud_rviz/EvalHudPanel
    Name: Eval HUD
  - Class: motion_safety_rviz/MotionSafetyPanel
    Name: Motion Safety
  - Class: view_follow_rviz/ViewFollowPanel
    Follow: false
    FollowHeading: false
    Name: Camera Follow
  - Class: legend_rviz/LegendPanel
    Name: Legend
