<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stonefish_groundtruth_mapping</name>
  <version>0.1.0</version>
  <description>Ground-truth SLAM pipeline: Stonefish → depth_image_proc → OctoMap</description>
  <maintainer email="ave4000@hw.ac.uk">arcod7</maintainer>
  <license>MIT</license>

  <!-- Python nodes -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <!-- Nodes launched by this package -->
  <exec_depend>stonefish_ros2</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>
  <exec_depend>octomap_server</exec_depend>
  <exec_depend>frontier_slam</exec_depend>  <!-- tsdf.launch.py launches tsdf_mapper -->
  <exec_depend>world</exec_depend>  <!-- tf.launch.py resolves the scenario via this package's share dir -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
