<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tsdf_octomap</name>
  <version>0.1.0</version>
  <description>Builds an octomap::OcTree from the VDBFusion TSDF grid, so the TSDF belief map is queryable as an octree for 3-D frontier detection and 3-D A*.</description>
  <maintainer email="antoine.esman7@gmail.com">antoine</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>octomap</depend>
  <depend>octomap_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
