<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>frontier_slam</name>
  <version>0.1.0</version>
  <description>Frontier-based exploration: OctoMap projected map → waypoint → thruster control</description>
  <maintainer email="antoine.esman7@gmail.com">antoine</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>python3-numpy</depend>
  <depend>python3-scipy</depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- vdbfusion and pymavlink have no Ubuntu 24.04 rosdep/apt key here.
       Install the Python requirements documented at the repository root. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
